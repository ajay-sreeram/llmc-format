{
  "name": "vscode-llmc",
  "displayName": "LLMC File Viewer",
  "description": "View and edit LLM chat conversations with thinking tokens and tool calls. Supports DeepSeek, Qwen, Claude formats.",
  "version": "0.2.0",
  "publisher": "sreeramajay",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajay-sreeram/llmc-format"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages", "Visualization"],
  "keywords": ["llm", "chat", "deepseek", "qwen", "claude", "thinking", "reasoning", "tool-use"],
  "activationEvents": [
    "onLanguage:llmc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "llmc",
        "aliases": ["LLMC", "llmc"],
        "extensions": [".llmc"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "llmc",
        "scopeName": "text.html.markdown.llmc",
        "path": "./syntaxes/llmc.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "llmc.openPreview",
        "title": "LLMC: Open Preview"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "marked": "^12.0.0"
  }
}
